NODE_ENV: production
PORT: "8080"
API_VERSION: "1.0.0"
API_URL: "https://SUBSTITUIR.run.app"
CLOUD_RUN_SERVICE_URL: "https://SUBSTITUIR.run.app"
CORS_ORIGINS: "https://docvia-privacidade.pages.dev"
PRIVACY_CONTACT_EMAIL: "zrafaelxd07@gmail.com"
PRIVACY_POLICY_URL: "https://docvia-privacidade.pages.dev/privacidade"
ACCOUNT_DELETION_URL: "https://docvia-privacidade.pages.dev/excluir-conta"
PASSWORD_RESET_URL: "docvia://reset-password"
EMAIL_VERIFICATION_URL: "docvia://verify-email"
MAIL_FROM: "DocVia <nao-responda@SUBSTITUIR>"
PAYMENT_PROVIDER: none
AI_PROVIDER: gemini
GEMINI_MODEL: gemini-2.5-flash-lite
AI_PAID_TIER_CONFIRMED: "true"
AI_TIMEOUT_MS: "60000"
AI_MAX_OUTPUT_TOKENS: "4096"
AI_GLOBAL_DAILY_LIMIT: "100"
AI_MAX_TEXT_CHARS: "120000"
SENSITIVE_DOCUMENTS_ENABLED: "false"
STORAGE_PROVIDER: r2
R2_ACCOUNT_ID: "SUBSTITUIR"
R2_BUCKET: docvia-documents
JOB_MODE: cloud-tasks
GCP_PROJECT_ID: "SUBSTITUIR"
GCP_LOCATION: southamerica-east1
CLOUD_TASKS_QUEUE: docvia-document-processing
AUTO_MIGRATE: "false"
DB_SSL: "true"
DB_SSL_REJECT_UNAUTHORIZED: "true"
DB_SSL_CA_FILE: "/app/config/certs/supabase-prod-ca-2021.crt"
DB_POOL_MAX: "5"
DB_IDLE_TIMEOUT_MS: "30000"
DB_CONNECTION_TIMEOUT_MS: "10000"
OCR_ENABLED: "true"
OCR_LANGUAGE: por
OCR_TIMEOUT_MS: "120000"
PDF_MAX_PAGES: "30"
TESSERACT_PATH: /app
RATE_LIMIT_MAX: "300"
AUTH_RATE_LIMIT_MAX: "8"
