NODE_ENV=development
PORT=3000

DB_USER=postgres
DB_HOST=localhost
DB_PASSWORD=troque-esta-senha
DB_NAME=DocVia
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Preferível no Supabase: cole a URI do Transaction Pooler.
DATABASE_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-caracteres

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Em produção, somente marque true depois de ativar um plano que não use
# documentos enviados para melhorar os produtos do provedor.
AI_PAID_TIER_CONFIRMED=false
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4096
AI_GLOBAL_DAILY_LIMIT=250
# Mantenha false no primeiro lançamento. Exames contêm dados pessoais sensíveis.
SENSITIVE_DOCUMENTS_ENABLED=false
OPENAI_API_KEY=
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
PASSWORD_RESET_URL=docvia://reset-password
PRIVACY_CONTACT_EMAIL=zrafaelxd07@gmail.com
PRIVACY_POLICY_URL=https://docvia-privacidade.rafael-o-silva30.chatgpt.site/privacidade
ACCOUNT_DELETION_URL=https://docvia-privacidade.rafael-o-silva30.chatgpt.site/excluir-conta

API_URL=http://localhost:3000
API_VERSION=1.0.0
# Em produção, informe somente os domínios autorizados separados por vírgula.
CORS_ORIGINS=*

STORAGE_DIR=./storage
STORAGE_PUBLIC_URL=/uploads
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=docvia-documents

# Local: worker. Cloud Run: cloud-tasks.
JOB_MODE=worker
GCP_PROJECT_ID=
GCP_LOCATION=southamerica-east1
CLOUD_TASKS_QUEUE=docvia-document-processing
CLOUD_RUN_SERVICE_URL=
JOB_RUNNER_SECRET=
AUTO_MIGRATE=true

TESSERACT_PATH=.
OCR_ENABLED=true
OCR_LANGUAGE=por
OCR_TIMEOUT_MS=120000
PDF_MAX_PAGES=30
AI_MAX_TEXT_CHARS=120000
