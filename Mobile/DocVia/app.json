{
  "expo": {
    "name": "DocVia",
    "slug": "docvia",
    "owner": "docvia-app",
    "description": "Organize documentos, identifique prazos e entenda pontos importantes com apoio de inteligência artificial.",
    "version": "1.0.5",
    "scheme": "docvia",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "versionCode": 6,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#071316",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "br.com.docvia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "69768ee3-f138-4da2-8bda-1a63ac1aa8e5"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071316",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#071316",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita o acesso à câmera para digitalizar documentos no DocVia.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#147D92"
        }
      ]
    ]
  }
}
