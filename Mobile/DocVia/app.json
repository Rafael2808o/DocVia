{
  "expo": {
    "name": "DocVia",
    "slug": "DocVia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Permita o acesso para selecionar documentos no DocVia.", "cameraPermission": "Permita o acesso à câmera para digitalizar documentos no DocVia." }],
      ["expo-notifications", { "icon": "./assets/icon.png", "color": "#146C94" }],
      ["expo-local-authentication", { "faceIDPermission": "Permita a biometria para proteger o DocVia." }]
    ]
  }
}
